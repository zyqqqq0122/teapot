process {
    cpus = 2
    time = { "${4 * task.attempt}h" }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'REMOVE_SURVEY_SCANS|CALIBRATE_FRAGMENT_MZ|SEARCH_DIA|CONTEXT_SEARCH' {
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
    }
    withName: '.*:PREPARE_CHROMATOGRAM_LIBRARY:CALIBRATE_FRAGMENT_MZ' {
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    }

    clusterOptions = { "${params.cluster_options} --mem ${16 * task.attempt}G" }

    withName: 'HARMONIZE_RT|HARMONIZE_RT_TARGET|HARMONIZE_RT_BACKGROUND' {
        cpus           = 4
        clusterOptions = { "${params.cluster_options} --mem ${96 * task.attempt}G" }
        time           = { "${6 * task.attempt}h" }
    }
    withName: MERGE_LIBRARIES {
        cpus           = 4
        clusterOptions = { "${params.cluster_options} --mem ${96 * task.attempt}G" }
        time           = { "${6 * task.attempt}h" }
    }
    withName: 'ASSERT_RT_COHERENT|ASSERT_BACKGROUND_ADEQUATE' {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${48 * task.attempt}G" }
        time           = { "${2 * task.attempt}h" }
    }
    withName: DERIVE_IRT_FROM_REFERENCE_LIST {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${32 * task.attempt}G" }
        time           = { "${2 * task.attempt}h" }
    }
    withName: 'EMIT_IRT_LIBRARY|ADD_DECOYS_TO_REFERENCE_LIST' {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${16 * task.attempt}G" }
        time           = { "${1 * task.attempt}h" }
    }
    withName: ASSERT_SEARCH_PRODUCTIVE {
        cpus           = 1
        clusterOptions = { "${params.cluster_options} --mem ${8 * task.attempt}G" }
        time           = { "${20 * task.attempt}m" }
    }
    withName: KOINA_PREDICT {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${16 * task.attempt}G" }
        time           = { "${2 * task.attempt}h" }
    }
    withName: ENCYCLOPEDIA_LIBEXPORT {
        cpus           = 4
        clusterOptions = { "${params.cluster_options} --mem ${32 * task.attempt}G" }
        time           = { "${4 * task.attempt}h" }
    }
    withName: MERGE_GPF {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${16 * task.attempt}G" }
        time           = { "${2 * task.attempt}h" }
    }
    withName: SEARCH_GPF {
        cpus           = 32
        clusterOptions = { "${params.cluster_options} --mem ${64 * task.attempt}G" }
        time           = { "${8 * task.attempt}h" }
    }
    withName: SEARCH_DIA {
        cpus           = 8
        clusterOptions = { "${params.cluster_options} --mem ${32 * task.attempt}G" }
        time           = { "${8 * task.attempt}h" }
    }
    withName: CONTEXT_SEARCH {
        cpus           = 8
        clusterOptions = { "${params.cluster_options} --mem ${32 * task.attempt}G" }
        time           = { "${4 * task.attempt}h" }
    }
    withName: BLIB_TO_DLIB {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${8 * task.attempt}G" }
        time           = { "${1 * task.attempt}h" }
    }
    withName: BLIB_TO_REFERENCE_LIST {
        cpus           = 1
        clusterOptions = { "${params.cluster_options} --mem ${4 * task.attempt}G" }
        time           = { "${30 * task.attempt}m" }
    }
    withName: MSCONVERT {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${16 * task.attempt}G" }
        time           = { "${2 * task.attempt}h" }
    }
    withName: DLIB_TO_OPENSWATH_TSV {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${8 * task.attempt}G" }
        time           = { "${1 * task.attempt}h" }
    }
    withName: OPENSWATH_ASSAY_GENERATOR {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${8 * task.attempt}G" }
        time           = { "${1 * task.attempt}h" }
    }
    withName: OPENSWATH_DECOY_GENERATOR {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${8 * task.attempt}G" }
        time           = { "${1 * task.attempt}h" }
    }
    withName: OPENSWATH_WORKFLOW {
        cpus           = 8
        clusterOptions = { "${params.cluster_options} --mem ${32 * task.attempt}G" }
        time           = { "${8 * task.attempt}h" }
    }
    withName: SPLIT_OPENSWATH_FEATURES {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${8 * task.attempt}G" }
        time           = { "${1 * task.attempt}h" }
    }
    withName: CONTEXT_MS_RUN {
        cpus           = 4
        clusterOptions = { "${params.cluster_options} --mem ${16 * task.attempt}G" }
        time           = { "${2 * task.attempt}h" }
    }
    withName: 'COMPLETE_CHANNELS|COMPLETE_CHANNELS_CHROMATOGRAM' {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${8 * task.attempt}G" }
        time           = { "${1 * task.attempt}h" }
    }
    withName: PYPROPHET_SUBSAMPLE {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${8 * task.attempt}G" }
        time           = { "${1 * task.attempt}h" }
    }
    withName: PYPROPHET_MERGE {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${16 * task.attempt}G" }
        time           = { "${1 * task.attempt}h" }
    }
    withName: PYPROPHET_LEARN {
        cpus           = 8
        clusterOptions = { "${params.cluster_options} --mem ${32 * task.attempt}G" }
        time           = { "${4 * task.attempt}h" }
    }
    withName: PYPROPHET_APPLY {
        cpus           = 4
        clusterOptions = { "${params.cluster_options} --mem ${16 * task.attempt}G" }
        time           = { "${2 * task.attempt}h" }
    }
    withName: PYPROPHET_EXPORT {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${8 * task.attempt}G" }
        time           = { "${1 * task.attempt}h" }
    }
    withName: QUANTIFY_HEAVY_LIGHT {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${8 * task.attempt}G" }
        time           = { "${1 * task.attempt}h" }
    }
    withName: TRIC_FEATURE_ALIGNMENT {
        cpus           = 4
        clusterOptions = { "${params.cluster_options} --mem ${16 * task.attempt}G" }
        time           = { "${2 * task.attempt}h" }
    }
    withName: DIATHEM_QUANT {
        cpus           = 8
        clusterOptions = { "${params.cluster_options} --mem ${32 * task.attempt}G" }
        time           = { "${4 * task.attempt}h" }
    }
    withName: MERGE_QUANT_OPENSWATH_PRM {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${8 * task.attempt}G" }
        time           = { "${1 * task.attempt}h" }
    }
    withName: MERGE_QUANT_OPENSWATH_DIA {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${8 * task.attempt}G" }
        time           = { "${1 * task.attempt}h" }
    }
    withName: MERGE_QUANT_ENCYCLOPEDIA_DIA {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${8 * task.attempt}G" }
        time           = { "${1 * task.attempt}h" }
    }
    withName: MERGE_QUANT_ENCYCLOPEDIA_PRM {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${8 * task.attempt}G" }
        time           = { "${1 * task.attempt}h" }
    }
    withName: ASSERT_QUANT_PRODUCTIVE {
        cpus           = 1
        clusterOptions = { "${params.cluster_options} --mem ${4 * task.attempt}G" }
        time           = { "${20 * task.attempt}m" }
    }
    withName: ENCYCLOPEDIA_LIBEXPORT_PER_SAMPLE {
        cpus           = 4
        clusterOptions = { "${params.cluster_options} --mem ${32 * task.attempt}G" }
        time           = { "${4 * task.attempt}h" }
    }
    withName: FINALIZE_QUANT {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${16 * task.attempt}G" }
        time           = { "${1 * task.attempt}h" }
    }
    withName: EXTRACT_OPENSWATH_INTENSITY {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${8 * task.attempt}G" }
        time           = { "${1 * task.attempt}h" }
    }
    withName: AUGMENT_CONTEXT_FEATURES {
        cpus           = 2
        clusterOptions = { "${params.cluster_options} --mem ${8 * task.attempt}G" }
        time           = { "${1 * task.attempt}h" }
    }
}
