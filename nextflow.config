// TEAPOT — Nextflow pipeline configuration

params {
    // Input/output
    input          = null          // path to sample sheet (CSV)
    outdir         = 'results'
    tracedir       = "${params.outdir}/pipeline_info"

    // Spectral library / reference
    spectral_lib   = null          // .tsv/.pqp spectral library for OpenSWATH
    fasta          = null          // proteome FASTA

    // Tool-specific
    irt_library    = null          // iRT library for OpenSWATH RT calibration
    encyclopedia_params = ''       // extra flags forwarded to EncyclopeDIA
    openswath_params    = ''       // extra flags forwarded to OpenSWATH

    // Resources
    max_cpus       = 16
    max_memory     = '128.GB'
    max_time       = '240.h'
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
profiles {

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = "$HOME/.singularity/cache"
        docker.enabled         = false
    }

    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
    }

    local {
        process.executor = 'local'
    }

    slurm {
        process.executor       = 'slurm'
        process.queue          = 'normal'
        process.clusterOptions = '--account=<project_account>'
    }

    test {
        params.input         = 'test/samplesheet.csv'
        params.spectral_lib  = 'test/library.tsv'
        params.fasta         = 'test/proteome.fasta'
        params.max_cpus      = 4
        params.max_memory    = '8.GB'
        params.max_time      = '1.h'
    }
}

// ---------------------------------------------------------------------------
// Process defaults & container images
// ---------------------------------------------------------------------------
process {
    cpus   = 4
    memory = '16.GB'
    time   = '4.h'

    errorStrategy = { task.exitStatus in [140, 143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: 'openswath' {
        container = 'quay.io/biocontainers/openswathtools:2.8.0--h9ee0642_2'
        cpus      = 8
        memory    = '32.GB'
        time      = '12.h'
    }

    withLabel: 'encyclopedia' {
        container = 'quay.io/biocontainers/encyclopedia:1.12.2--hdfd78af_0'
        cpus      = 8
        memory    = '32.GB'
        time      = '12.h'
    }

    withLabel: 'pyopenms' {
        container = 'quay.io/biocontainers/pyopenms:3.1.0--py310h4b81fae_0'
        cpus      = 4
        memory    = '16.GB'
    }

    withLabel: 'pyprophet' {
        container = 'quay.io/biocontainers/pyprophet:2.2.5--py310h4b81fae_1'
        cpus      = 4
        memory    = '16.GB'
    }
}

// ---------------------------------------------------------------------------
// Execution reports
// ---------------------------------------------------------------------------
timeline {
    enabled = true
    file    = "${params.tracedir}/execution_timeline.html"
}

report {
    enabled = true
    file    = "${params.tracedir}/execution_report.html"
}

trace {
    enabled = true
    file    = "${params.tracedir}/execution_trace.txt"
    fields  = 'task_id,name,status,exit,realtime,%cpu,rss,vmem,rchar,wchar'
}

dag {
    enabled = true
    file    = "${params.tracedir}/pipeline_dag.svg"
}

// ---------------------------------------------------------------------------
// Manifest
// ---------------------------------------------------------------------------
manifest {
    name            = 'TEAPOT'
    description     = 'Targeted Evaluation & Analysis Pipeline for Proteomics On Tandem mass spectrometry'
    author          = 'thanadol-git'
    version         = '0.1.0'
    nextflowVersion = '>=23.04.0'
    mainScript      = 'main.nf'
}
