manifest {
    name        = 'teapot'
    description = 'Targeted Evaluation & Analysis Pipeline for Proteomics on Tandem MS'
    mainScript  = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version     = '0.1.0'
}

params {
    input  = null
    fasta  = null

    dlib          = null
    blib          = null
    elib          = null
    library_sheet = null
    use_koina     = false
    koina_models = 'Prosit_2020_HCD;IM2Deep_CCS;Prosit_2019_iRT'
    koina_url    = 'https://koina.wilhelmlab.org:443/'

    fdr = 0.01

    gpf_search_args = ''
    dia_search_args = ''

    libexport_args  = ''

    encyclopedia_jar = '/opt/encyclopedia/encyclopedia.jar'
    encyclopedia_container = 'docker://ghcr.io/shannon225/encyclopedia:6.8.29-teapot'

    add_decoys_to_reference_list = true

    context_search_args = ''

    search_min_reference_ids = 10

    reference_list_decoy_jar        = "${projectDir}/assets/masslist-decoys.jar"
    java_mem         = '8g'

    peakpicking  = '--filter "peakPicking vendor msLevel=1-"'
    otherfilters = ''

    openswath_pqp = null
    openswath_tsv = null
    openswath_blib = null
    openswath_assaygen_args = ''
    openswath_decoygen_args = ''

    openswath_container = 'docker://ghcr.io/openswath/openswath@sha256:509feb438a20252585ff77e05c08a2cd41227ea290e07a959f842a144b6703b8'
    pyprophet_container = 'docker://ghcr.io/pyprophet/pyprophet@sha256:fb473fe3222305a94ffd7f9b2900d2d863c182d44108e02daff445e0b7ad08b8'
    openswath_search_args   = '-force -mz_extraction_window 30 -mz_extraction_window_unit ppm -mz_extraction_window_ms1 20 -mz_extraction_window_ms1_unit ppm -mz_correction_function regression_delta_ppm -enable_ms1 true -rt_extraction_window 600 -Library:override_group_label_check -RTNormalization:estimateBestPeptides -RTNormalization:alignmentMethod lowess -Scoring:stop_report_after_feature 5'

    openswath_occupancy_tolerance    = 0.4
    openswath_max_occupancy          = 0.35
    openswath_occupancy_window_width = null
    openswath_feasibility_warn_only  = false
    openswath_auto_matching_window   = true
    skip_openswath_feasibility       = false

    background_source      = 'none'
    background_library     = null
    background_fasta       = null
    background_min_targets = 500

    background_koina = false

    rt_harmonize_fallback              = 'fail'
    rt_harmonize_min_anchors           = 5
    rt_harmonize_min_r2                = 0.98
    rt_harmonize_min_anchor_coverage   = 0.8
    rt_coherence_max_range_ratio       = 3.0
    rt_coherence_require_iqr_overlap   = true
    irt_top_transitions                = 6

    irt_library = null
    irt_anchors = null

    mod_mass_tolerance         = 0.01
    unmapped_mod_max_fraction  = 0.05

    heavy_label = []

    complete_channels_ion_types            = ['b','y']
    complete_channels_max_frag_charge      = 2
    complete_channels_tolerance_ppm        = 20.0
    complete_channels_coverage_hard_floor  = 0.5
    complete_channels_coverage_warn_below  = 0.9
    complete_channels_skip_proteins        = []

    openswath_prm_fdr                           = 'context'
    pyprophet_level                       = 'ms2'


    quant_min_runs         = 2
    quant_require_min_runs = false

    quant_max_zero_ion_fraction = 0.5

    standard_amounts = null

    pyprophet_learn_args  = '--classifier=XGBoost --xeval_num_iter=3 --ss_initial_fdr=0.05 --ss_iteration_fdr=0.01'
    pyprophet_apply_args  = '--classifier=XGBoost'
    pyprophet_export_args = ''

    run_tric  = false
    tric_args = '--method LocalMST --realign_method lowess_cython --max_rt_diff 60 --mst:useRTCorrection True --mst:Stdev_multiplier 3.0 --fdr_cutoff 0.01 --max_fdr_quality 0.05'
    tric_recovery_min_quality = 0.05

    diathem_container = 'docker://ghcr.io/statisticalbiotechnology/diathem:quant'
    diathem_library   = null
    diathem_args      = ''
    run_diathem       = true
    diathem_precursor_tol = null
    diathem_rt_window     = null
    diathem_targets_source = 'reference'

    diathem_fragment_ppm  = null
    diathem_library_ppm   = null
    diathem_fragment_tol_th = null
    diathem_src           = null

    primary_abundance = 'openswath'

    augment_context_with_diathem = false

    openswath_prm_encyclopedia_quant = false

    min_consistency   = 0.0

    context_container         = 'docker://ghcr.io/shannon225/context-ms:main'
    python_container          = 'docker://quay.io/biocontainers/pandas:2.2.1'
    msconvert_container       = 'docker://proteowizard/pwiz-skyline-i-agree-to-the-vendor-licenses'
    context_engine            = 'mprophet'
    context_input_profile     = 'auto'
    context_seed_coefficients = 'encyclopedia'
    context_args              = ''

    max_cpus = Runtime.runtime.availableProcessors()

    container_cache_dir = "${projectDir}/apptainer_cache"
    container_tmp_dir   = "${projectDir}/apptainer_tmp"

    outdir       = 'results'
    work_dir     = null
    publish_mode = 'copy'

    cluster_options = ''
}

apptainer {
    autoMounts   = true
    enabled      = false
    envWhitelist = ['USER']
    pullTimeout  = '60m'
    cacheDir     = params.container_cache_dir
}

env {
    APPTAINER_TMPDIR   = params.container_tmp_dir
    SINGULARITY_TMPDIR = params.container_tmp_dir
}

includeConfig 'conf/base.config'

workDir = params.work_dir ?: "${params.outdir}/pipeline_info/work"

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/dag.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}

process.container = params.encyclopedia_container

profiles {
    standard {
        process.executor       = 'local'
        process.resourceLimits = [ cpus: params.max_cpus as int ]
    }
    docker {
        docker.enabled         = true
        process.resourceLimits = [ cpus: params.max_cpus as int ]
    }
    apptainer {
        apptainer.enabled      = true
        process.resourceLimits = [ cpus: params.max_cpus as int ]
    }
    hpc {
        // SLURM. Site resources come from a -c config, e.g. conf/slurm.config.
        process.executor             = 'slurm'
        process.clusterOptions       = { "${params.cluster_options}".trim() }
        executor.perCpuMemAllocation = true
        apptainer.enabled            = true
    }
    test {
        params.input = "${projectDir}/assets/samplesheet.example.csv"
    }
}

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':').last().toLowerCase()}" },
        mode: params.publish_mode,
        saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
    ]
}
